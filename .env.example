# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is git-ignored, so your secrets stay on your machine.

# Free key from https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_key_here

# What to ingest (comma-separated)
CRYPTO_IDS=bitcoin,ethereum,solana
STOCK_SYMBOLS=AAPL,MSFT,NVDA

# Where raw API responses are saved before loading
RAW_DATA_DIR=data/raw

# Postgres connection (used from Phase 3 on)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=market
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=change_me
